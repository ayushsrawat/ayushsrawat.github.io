---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
	<article class="prose">
		<nav class="breadcrumb">
			<a href="/">Home</a>
			<span class="separator">/</span>
			<span class="current">{post.data.title}</span>
		</nav>

		<header class="post-header">
			<h1 class="title">{post.data.title}</h1>
			<div class="meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{
						post.data.pubDate.toLocaleDateString("en-us", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})
					}
				</time>
			</div>
		</header>

		<div class="content">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.prose {
		margin: 0 auto;
	}

	.breadcrumb {
		margin-bottom: 2rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.breadcrumb a {
		color: var(--text-secondary);
		border-bottom: 1px solid transparent;
	}

	.breadcrumb a:hover {
		color: var(--accent-color);
		border-bottom-color: var(--accent-color);
	}

	.current {
		color: var(--text-color);
	}

	.separator {
		margin: 0 0.5rem;
		color: var(--border-color);
	}

	.post-header {
		margin-bottom: 3rem;
		text-align: center;
	}

	.meta {
		display: flex;
		justify-content: center;
		color: var(--text-secondary);
		font-size: 0.9rem;
		margin-bottom: 1rem;
		gap: 0.5rem;
	}

	.title {
		font-size: 2.5rem;
		line-height: 1.2;
		margin-bottom: 2rem;
		letter-spacing: -0.02em;
	}

	/* Markdown Content Styling */
	.content {
		font-family: var(--font-family-serif);
		font-size: 1.125rem;
		line-height: 1.8;
		color: var(--text-color);
	}

	:global(.content h1),
	:global(.content h2),
	:global(.content h3),
	:global(.content h4) {
		font-family: var(--font-family-base);
		color: var(--text-color);
		margin-top: 3rem;
		margin-bottom: 1.5rem;
	}

	:global(.content p) {
		margin-bottom: 1.5rem;
	}

	:global(.content ul),
	:global(.content ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	:global(.content li) {
		margin-bottom: 0.5rem;
	}

	:global(.content blockquote) {
		border-left: 4px solid var(--accent-color);
		padding-left: 1.5rem;
		margin: 2rem 0;
		font-style: italic;
		color: var(--text-secondary);
	}

	:global(.content pre) {
		padding: 1.5rem;
		border-radius: 8px;
		margin: 2rem 0;
		overflow-x: auto;
		font-size: 0.9em;
		background-color: #1e1e1e !important; /* Force dark bg for code in ALL modes for better contrast */
		border: 1px solid var(--border-color);
		position: relative; /* For copy button positioning */
	}

	/* Removed the light mode override that was causing visibility issues (light text on light bg) */

	:global(.content code) {
		background-color: rgba(125, 125, 125, 0.1);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
		font-family: "Menlo", "Monaco", "Courier New", monospace;
		font-size: 0.85em;
	}

	/* Copy Button Styles */
	:global(.copy-code) {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		background-color: transparent;
		border: none;
		border-radius: 4px;
		color: #e0e0e0;
		cursor: pointer;
		opacity: 0;
		transition:
			opacity 0.2s,
			background-color 0.2s,
			color 0.2s;
		padding: 0.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	:global(.content pre:hover .copy-code) {
		opacity: 0.7;
	}

	:global(.content pre:hover .copy-code:hover) {
		opacity: 1;
		background-color: rgba(255, 255, 255, 0.1);
	}

	/* SVG Icon styles */
	:global(.copy-code svg) {
		width: 1.25rem;
		height: 1.25rem;
		stroke-width: 2;
	}
</style>

<script>
	// Icons as strings
	const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
	const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

	// Add copy buttons to code blocks
	document.addEventListener("astro:page-load", () => {
		addCopyButtons();
	});

	// Initial load
	addCopyButtons();

	function addCopyButtons() {
		const codeBlocks = document.querySelectorAll("pre");

		codeBlocks.forEach((block) => {
			// Check if button already exists to prevent duplicates
			if (block.querySelector(".copy-code")) return;

			const button = document.createElement("button");
			button.className = "copy-code";
			button.innerHTML = copyIcon;
			button.setAttribute("aria-label", "Copy code");

			button.addEventListener("click", async () => {
				const code =
					block.querySelector("code")?.innerText || block.innerText;

				try {
					await navigator.clipboard.writeText(code);
					button.innerHTML = checkIcon;
					button.style.color = "#4ade80"; // Green color for success

					setTimeout(() => {
						button.innerHTML = copyIcon;
						button.style.color = ""; // Reset color
					}, 2000);
				} catch (err) {
					console.error("Failed to copy mode", err);
				}
			});

			block.appendChild(button);
		});
	}
</script>
