---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
	<section class="intro">
		<h1>Hi, I'm Ayush.</h1>
		<p>
			I'm a software engineer and writer. I like building things and talking about them.
			This is my digital garden where I share my thoughts on engineering, design, and life.
		</p>
	</section>

	<section>
		<div class="section-title">Latest Posts</div>
		<ul class="posts-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.slug}/`}>
							<div class="post-header">
								<h2 class="title">{post.data.title}</h2>
								<span class="date">
									{post.data.pubDate.toLocaleDateString('en-us', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</span>
							</div>
							<p class="description">{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.intro {
		margin-bottom: 2rem;
	}

	.intro h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		letter-spacing: -0.05em;
	}
	
	.intro p {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 45ch;
	}

	.section-title {
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}

	ul {
		list-style-type: none;
		padding: 0;
	}
	
	li {
		margin-bottom: 3rem;
	}

	a {
		display: block;
		transition: transform 0.2s ease;
	}

	.post-header {
		margin-bottom: 0.5rem;
	}

	.title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text-color);
		display: block; /* Ensure it takes full width */
	}

	.date {
		font-size: 0.875rem;
		color: var(--text-secondary);
		display: block; /* Stack under title */
		margin-top: 0.25rem;
		font-family: var(--font-family-base);
	}

	.description {
		margin: 0;
		color: var(--text-secondary);
		font-size: 1rem;
		line-height: 1.6;
	}
	
	/* Hover effects */
	a:hover .title {
		color: var(--accent-color);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
</style>
